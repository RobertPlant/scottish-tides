{
  "name": "@scottish-tides/mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "//lint": "`expo lint` (the wrapper) broke in expo 57.0.9: it resolves @typescript-eslint/parser from its own module context and fails, producing ~104 bogus `Parse errors in imported module` / import/namespace errors. Calling eslint directly is what the wrapper does anyway, and reports the real findings. Retry `expo lint` after a future SDK bump.",
    "lint": "eslint .",
    "test:engine": "node --import tsx --test lib/tides/*.test.ts",
    "test:unit": "node --import tsx --test lib/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "//build:android": "Release APK. The script enters devenv itself, prebuilds if android/ is missing, and fixes the NixOS aapt2. Env: PREBUILD=clean to regenerate android/, ABI=arm64-v8a for a much smaller/faster build.",
    "build:android": "scripts/build-android.sh",
    "screenshots": "node scripts/gen-screenshots.mjs"
  },
  "expo": {
    "autolinking": {
      "android": {
        "//exclude": "expo-location pulls in the proprietary play-services-location, which F-Droid forbids. Android uses modules/platform-location instead; iOS still links expo-location.",
        "exclude": [
          "expo-location"
        ]
      }
    }
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-vector-icons/ionicons": "^13.1.2",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.3",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-location": "~57.0.7",
    "expo-router": "~57.0.9",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.1",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
